# CrowdPulse / OmniVenue - Environment Configuration Template
# Copy this file to .env and adjust values as needed.

PORT=5000
NODE_ENV=development

# Database Provider ('supabase' or 'mongodb')
DB_PROVIDER=supabase

# Supabase Configuration (Free Tier from https://supabase.com -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Vite Frontend Supabase Env (Used by client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Fallback Database Connection (MongoDB URI)
# Used if DB_PROVIDER=mongodb or as secondary fallback
MONGODB_URI=mongodb://127.0.0.1:27017/crowdpulse

# Real-Time Heartbeat Interval (milliseconds)
TICK_INTERVAL_MS=5000
SIMULATION_SPEED=1

# External Free-Tier Public Routing & Map Endpoints (No API keys required)
OSRM_BASE_URL=http://router.project-osrm.org/route/v1/driving
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

